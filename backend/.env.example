SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (individual fields — used by settings.py)
DB_NAME=biblioteca
DB_USER=biblioteca
DB_PASSWORD=biblioteca
DB_HOST=localhost
DB_PORT=5432

# DATABASE_URL is the combined form (not used by settings.py, kept for reference)
# DATABASE_URL=postgres://biblioteca:biblioteca@localhost:5432/biblioteca

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Media files
MEDIA_ROOT=/data/media
COVERS_ROOT=/data/covers

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
