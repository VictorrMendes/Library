# ─── Django ──────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria

DEBUG=False

# Seu domínio Cloudflare (ex: biblioteca.seudominio.com ou abc123.cfargotunnel.com)
ALLOWED_HOSTS=seudominio.com,www.seudominio.com

# ─── Banco de dados ───────────────────────────────────────────────────────────
DB_NAME=biblioteca
DB_USER=biblioteca_user
DB_PASSWORD=troque-por-senha-forte
DB_HOST=db
DB_PORT=5432

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Arquivos ─────────────────────────────────────────────────────────────────
MEDIA_ROOT=/data/media
COVERS_ROOT=/data/covers
UPLOADS_ROOT=/uploads

# Caminho no servidor onde ficam os arquivos de manga/livros
MANGA_PATH=/srv/biblioteca/manga

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://seudominio.com

# ─── Frontend (build arg — Next.js embute isso no build) ─────────────────────
NEXT_PUBLIC_API_URL=https://seudominio.com/api
